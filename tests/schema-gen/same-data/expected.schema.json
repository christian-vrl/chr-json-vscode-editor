{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "ok",
        "score"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "tags",
    "meta"
  ]
}
