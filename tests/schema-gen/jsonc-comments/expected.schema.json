{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "list": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "nested": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "on"
      ]
    }
  },
  "required": [
    "name",
    "list",
    "nested"
  ]
}
