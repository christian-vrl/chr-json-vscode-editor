{
	"name"   : "chr-json-editor-demo",
	"version": "1.0.0",
	"description": "A configuration file whose description is long enough that it never fits on one line with the other members.",
	"server": {"host": "localhost", "port": 8080, "tls": false},
	"database": {
		"url"     : "postgres://db.example.test:5432/app",
		"pool"    : {"min": 2, "max": 10},
