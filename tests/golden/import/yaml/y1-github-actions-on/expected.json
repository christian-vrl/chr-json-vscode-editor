{
  "name": "CI",
  "on": {
    "push": {
      "branches": [
        "main"
      ]
    },
    "pull_request": null
  },
  "jobs": {
    "test": {
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "run": "npm test",
          "if": "${{ always() }}"
        }
      ]
    }
  },
  "octal-like": 777,
  "answers": [
    "yes",
    "no",
    "y",
    "n",
    "on",
    "off"
  ]
}
