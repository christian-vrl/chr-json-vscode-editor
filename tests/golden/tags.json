{
  "formats": ["json", "jsonc", "json5"],
  "tags": {
    "op": [
      "add",
      "replace",
      "remove",
      "move",
      "copy",
      "test",
      "test-fail",
      "compact",
      "sort",
      "data-diff",
      "format"
    ],
    "location": ["root", "nested-object", "array-start", "array-middle", "array-end", "document"],
    "comments": ["none", "before", "after", "inline", "leading"],
    "trailingComma": ["yes", "no"],
    "quote": ["single", "double"],
    "keyStyle": ["quoted", "unquoted"],
    "special": ["none", "hex", "infinity-nan", "multiline-string"]
  },
  "convert": {
    "pairs": [
      "json-to-jsonc",
      "json-to-json5",
      "jsonc-to-json",
      "jsonc-to-json5",
      "json5-to-json",
      "json5-to-jsonc",
      "jsonl-to-json",
      "jsonl-to-jsonc",
      "jsonl-to-json5",
      "json-to-jsonl",
      "jsonc-to-jsonl",
      "json5-to-jsonl"
    ],
    "rules": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "J1", "J2"],
    "location": ["root", "nested-object", "array"]
  },
  "csv": {
    "rules": {
      "export": ["X1", "X2", "X3", "X4", "X5", "X6", "X7"],
      "import": ["I1", "I2", "I3", "I4", "I5", "I6", "I7"]
    },
    "values": ["number", "true", "false", "null", "empty", "json", "text"],
    "features": ["one-column-null-row"],
    "delimiters": {
      "export": [",", ";", "\t", "|"],
      "import": [",", ";", "\t", "|", "detect"]
    }
  },
  "smartFormat": {
    "layout": ["inline", "compact-array", "table", "expanded"],
    "comments": [
      "none",
      "before",
      "after",
      "inline",
      "standalone",
      "multi-line-block",
      "between-key-and-value",
      "header",
      "footer",
      "with-warning"
    ],
    "trailingComma": ["yes", "no"],
    "special": [
      "none",
      "key-order",
      "unquoted-key",
      "single-quote",
      "hex",
      "infinity-nan",
      "plus-sign",
      "leading-dot",
      "line-continuation"
    ],
    "style": [
      "indent-tab",
      "indent-2",
      "indent-4",
      "crlf",
      "no-final-newline",
      "bom",
      "one-line-input"
    ]
  },
  "jsonl": {
    "rules": ["L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9", "L10"],
    "op": ["add", "replace", "remove", "move", "copy", "test", "test-fail"],
    "location": ["item", "nested", "root"]
  },
  "import": {
    "kinds": ["yaml", "toml", "xml"],
    "rules": {
      "all": ["A1", "A2", "A3", "A4", "A5", "A6"],
      "yaml": ["Y1", "Y2", "Y3", "Y4", "Y5", "Y6", "Y7", "Y8"],
      "toml": ["TM1", "TM2", "TM3", "TM4", "TM5"],
      "xml": ["XM1", "XM2", "XM3", "XM4", "XM5", "XM6", "XM7", "XM8"]
    },
    "tags": {
      "all": [
        "big-integer",
        "big-decimal",
        "hex-octal-binary",
        "non-finite",
        "proto-key",
        "too-deep",
        "bom",
        "utf16-bom",
        "malformed"
      ],
      "yaml": [
        "yaml-1.1-booleans",
        "yaml-github-actions-on",
        "yaml-multi-document",
        "yaml-empty",
        "yaml-merge-key",
        "yaml-alias-bomb",
        "yaml-cloudformation-tags",
        "yaml-duplicate-key",
        "yaml-complex-key"
      ],
      "toml": ["toml-dates", "toml-array-of-tables", "toml-int64-overflow"],
      "xml": [
        "xml-attributes",
        "xml-repeated",
        "xml-interleaved",
        "xml-mixed-content",
        "xml-cdata",
        "xml-namespaces",
        "xml-entity-bomb",
        "xml-external-entity",
        "xml-encoding-latin1",
        "xml-empty-element"
      ]
    },
    "perKind": {
      "too-deep": ["yaml", "toml", "xml"],
      "malformed": ["yaml", "toml", "xml"],
      "big-decimal": ["yaml", "xml"]
    }
  }
}
