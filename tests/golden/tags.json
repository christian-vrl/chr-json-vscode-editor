{
  "formats": ["json", "jsonc", "json5"],
  "tags": {
    "op": [
      "add",
      "replace",
      "remove",
      "move",
      "copy",
      "test",
      "test-fail",
      "compact",
      "sort",
      "data-diff",
      "format"
    ],
    "location": ["root", "nested-object", "array-start", "array-middle", "array-end", "document"],
    "comments": ["none", "before", "after", "inline", "leading"],
    "trailingComma": ["yes", "no"],
    "quote": ["single", "double"],
    "keyStyle": ["quoted", "unquoted"],
    "special": ["none", "hex", "infinity-nan", "multiline-string"]
  },
  "convert": {
    "pairs": [
      "json-to-jsonc",
      "json-to-json5",
      "jsonc-to-json",
      "jsonc-to-json5",
      "json5-to-json",
      "json5-to-jsonc"
    ],
    "rules": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"],
    "location": ["root", "nested-object", "array"]
  },
  "csv": {
    "rules": {
      "export": ["X1", "X2", "X3", "X4", "X5", "X6", "X7"],
      "import": ["I1", "I2", "I3", "I4", "I5", "I6", "I7"]
    },
    "values": ["number", "true", "false", "null", "empty", "json", "text"],
    "features": ["one-column-null-row"],
    "delimiters": {
      "export": [",", ";", "\t", "|"],
      "import": [",", ";", "\t", "|", "detect"]
    }
  }
}
