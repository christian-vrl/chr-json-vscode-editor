// Big numbers (spec 015 criterion 4) in JSON5 syntax.
{
  a: 98765432109876543210, // an id past 2^53
  b: 0.1000000000000000000001,
  c: 1e400,
  d: 4.0,
  e: 9007199254740993,
  f: 1E-400,
  hex: 0xAB54A98CEB1F0AD2,
  plain: [9007199254740991, 0.1, 1e2, -0, 1.5e300, +7],
  ids: [1e400, -12345678901234567890, 5, 12345678901234567891, 0.1000000000000000000001, 12345678901234567890, 0.1],
  records: [
    { id: 12345678901234567891, name: 'second' },
    { id: 9007199254740993, name: 'smallest' },
    { id: 12345678901234567890, name: 'first' },
    { id: 7, name: 'plain' },
  ],
}
