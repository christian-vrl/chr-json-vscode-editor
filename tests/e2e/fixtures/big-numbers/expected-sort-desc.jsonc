// Big numbers (spec 015 criterion 4), with comments that edits keep.
{
  "a": 12345678901234567890, // an id past 2^53
  "b": 0.1000000000000000000001,
  "c": 1e400,
  "d": 4.0,
  "e": 9007199254740993,
  "f": 1E-400,
  /* plain numbers stay plain */
  "plain": [9007199254740991, 0.1, 1e2, -0, 1.5e300],
  "ids": [1e400, 12345678901234567891, 12345678901234567890, 5, 0.1000000000000000000001, 0.1, -12345678901234567890],
  "records": [
    { "id": 12345678901234567891, "name": "second" },
    { "id": 9007199254740993, "name": "smallest" },
    { "id": 12345678901234567890, "name": "first" },
    { "id": 7, "name": "plain" },
  ],
}
