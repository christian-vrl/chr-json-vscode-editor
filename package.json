{
  "name": "chr-json-editor-workspace",
  "private": true,
  "description": "Workspace root for CHR JSON Editor (see AGENTS.md).",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:golden": "node scripts/test-golden.mjs",
    "test:e2e": "pnpm --filter chr-json-editor run test:e2e",
    "test:web": "pnpm --filter @chr-json-editor/app-shell run build && playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:offline": "node scripts/not-yet.mjs check:offline \"001 T8\"",
    "check:readme": "node scripts/not-yet.mjs check:readme \"spec 005\"",
    "package": "pnpm --filter chr-json-editor run package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "immutable-json-patch": "6.0.3",
    "json5": "2.2.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
