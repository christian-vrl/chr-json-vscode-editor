{
  "name": "chr-json-editor-spike-eval-location",
  "displayName": "CHR JSON Editor eval-location spike",
  "description": "Spike 004 T1: measures where Ajv can run (sandboxed iframe vs extension host). Dev-only; never packaged.",
  "version": "0.0.0",
  "private": true,
  "publisher": "christian-vrl",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "chrJsonSpike.evalLocation",
        "displayName": "CHR JSON eval-location spike",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "spike": "node run.mjs",
    "spike:mv3": "node mv3.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2"
  }
}
