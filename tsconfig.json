// Type-checks the TypeScript no package builds: tests, the golden loader and tool configs.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"],
    // validation.ts imports the draft-06 meta-schema JSON that ships in `ajv` (004 T4, UNK-031).
    "resolveJsonModule": true,
    // Tests import workspace packages from source, so type-aware lint never depends on a build.
    "paths": {
      "@chr-json-editor/core": ["./packages/core/src/index.ts"],
      "@chr-json-editor/app-shell/protocol": ["./packages/app-shell/src/protocol.ts"]
    }
  },
  "include": [
    "*.mts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "packages/*/test/**/*.ts",
    "packages/*/*.mts",
    "scripts/**/*.ts",
    "scripts/**/*.d.mts",
    // run-query.ts imports Lodash's source with Vite's `?raw` (011 T3); tests reach it from source.
    "packages/app-shell/src/query/lodash-source.d.ts"
  ]
}
