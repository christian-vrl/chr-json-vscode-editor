// Type-checks the TypeScript no package builds: tests, the golden loader and tool configs.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"],
    // Tests import workspace packages from source, so type-aware lint never depends on a build.
    "paths": { "@chr-json-editor/core": ["./packages/core/src/index.ts"] }
  },
  "include": [
    "*.mts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "packages/*/test/**/*.ts",
    "packages/*/*.mts",
    "scripts/**/*.ts",
    "scripts/**/*.d.mts"
  ]
}
