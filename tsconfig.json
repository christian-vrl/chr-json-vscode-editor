// Type-checks the TypeScript no package builds: tests, the golden loader and tool configs.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "*.mts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "packages/*/test/**/*.ts",
    "packages/*/*.mts",
    "scripts/**/*.d.mts"
  ]
}
