{
  "name": "@chr-json-editor/app-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Host-agnostic UI around vanilla-jsoneditor; talks only to a HostAdapter.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./ui": {
      "types": "./src/ui.d.ts",
      "default": "./dist/lib/app.js"
    },
    "./csv-preview": {
      "types": "./dist/csv-preview.d.ts",
      "default": "./dist/csv-preview.js"
    },
    "./compare": {
      "types": "./src/compare-ui.d.ts",
      "default": "./dist/lib/compare.js"
    },
    "./csv": {
      "types": "./src/csv-ui.d.ts",
      "default": "./dist/lib/csv.js"
    },
    "./ui.css": "./dist/lib/app.css",
    "./page.css": "./src/page.css"
  },
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.build.json && vite build && vite build -c vite.lib.config.mts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "json-source-map": "0.6.1",
    "svelte-check": "4.7.6",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@chr-json-editor/core": "workspace:*",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "immutable-json-patch": "6.0.3",
    "lodash": "4.18.1",
    "quickjs-emscripten-core": "0.32.0",
    "svelte": "5.57.2",
    "vanilla-jsoneditor": "3.13.0"
  }
}
