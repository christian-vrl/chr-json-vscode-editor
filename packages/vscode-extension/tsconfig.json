// Type-checks the extension host code (`tsc --noEmit`; the webview script has its own
// src/webview/tsconfig.json with the DOM library). esbuild (esbuild.mjs) bundles it, so modules
// resolve the way a bundler does. That lets the CommonJS bundle import the ESM
// workspace packages by value (004 T2). `paths` points them at source, as the root tsconfig does,
// so type checks and type-aware lint never depend on a build.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // validation.ts imports the draft-06 meta-schema JSON that ships in `ajv` (004 T4, UNK-031).
    "resolveJsonModule": true,
    "paths": {
      "@chr-json-editor/core": ["../core/src/index.ts"],
      "@chr-json-editor/app-shell/protocol": ["../app-shell/src/protocol.ts"],
      "@chr-json-editor/app-shell/csv-preview": ["../app-shell/src/csv-preview.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/webview"]
}
