// Type-checks the extension host and webview code (`tsc --noEmit`); esbuild (esbuild.mjs) bundles
// it, so modules resolve the way a bundler does. That lets the CommonJS bundle import the ESM
// workspace packages by value (004 T2). `paths` points them at source, as the root tsconfig does,
// so type checks and type-aware lint never depend on a build.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@chr-json-editor/core": ["../core/src/index.ts"],
      "@chr-json-editor/app-shell/protocol": ["../app-shell/src/protocol.ts"]
    }
  },
  "include": ["src"]
}
