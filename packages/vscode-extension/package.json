{
  "name": "chr-json-editor",
  "displayName": "CHR JSON Editor",
  "description": "Free, fully offline JSON, JSONC and JSON5 editor with tree, text and table views.",
  "version": "0.0.0",
  "private": true,
  "publisher": "christian-vrl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christian-vrl/chr-json-vscode-editor.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.136.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "chrJsonEditor.editor",
        "displayName": "CHR JSON Editor",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.jsonc"
          },
          {
            "filenamePattern": "*.json5"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "chrJsonEditor.openInEditor",
        "title": "Open in CHR JSON Editor",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.reopenAsText",
        "title": "Reopen as Text",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.selectFormat",
        "title": "Change Format",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.repairJson",
        "title": "Repair JSON",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.convertToJson",
        "title": "Convert to JSON",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.convertToJsonc",
        "title": "Convert to JSONC",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.convertToJson5",
        "title": "Convert to JSON5",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.convertToJsonl",
        "title": "Convert to JSON Lines",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.compareWith",
        "title": "Compare With…",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.compareSelected",
        "title": "Compare Selected",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.compareWithHead",
        "title": "Compare with HEAD",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.exportCsv",
        "title": "Export to CSV…",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.importCsv",
        "title": "Import CSV…",
        "category": "CHR JSON Editor"
      },
      {
        "command": "chrJsonEditor.convertCsvToJson",
        "title": "Convert CSV to JSON",
        "category": "CHR JSON Editor"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "chrJsonEditor.openInEditor",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5|jsonl|ndjson)$/ && activeCustomEditorId != chrJsonEditor.editor"
        },
        {
          "command": "chrJsonEditor.reopenAsText",
          "when": "activeCustomEditorId == chrJsonEditor.editor"
        },
        {
          "command": "chrJsonEditor.selectFormat",
          "when": "activeCustomEditorId == chrJsonEditor.editor"
        },
        {
          "command": "chrJsonEditor.repairJson",
          "when": "editorLangId =~ /^(json|jsonc|json5)$/ && activeEditor == workbench.editors.files.textFileEditor"
        },
        {
          "command": "chrJsonEditor.convertToJson",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != json) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(jsonc|json5|jsonl)$/)"
        },
        {
          "command": "chrJsonEditor.convertToJsonc",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != jsonc) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|json5|jsonl)$/)"
        },
        {
          "command": "chrJsonEditor.convertToJson5",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != json5) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|jsonc|jsonl)$/)"
        },
        {
          "command": "chrJsonEditor.convertToJsonl",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != jsonl) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|jsonc|json5)$/)"
        },
        {
          "command": "chrJsonEditor.compareWith",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5)$/ || activeCustomEditorId == chrJsonEditor.editor || editorLangId =~ /^(json|jsonc|json5)$/"
        },
        {
          "command": "chrJsonEditor.compareSelected",
          "when": "false"
        },
        {
          "command": "chrJsonEditor.compareWithHead",
          "when": "!isWeb && !chrJsonEditor.webHost && resourceScheme == file && resourceExtname =~ /^\\.(json|jsonc|json5)$/"
        },
        {
          "command": "chrJsonEditor.exportCsv",
          "when": "activeCustomEditorId == chrJsonEditor.editor || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|jsonc|json5)$/)"
        },
        {
          "command": "chrJsonEditor.importCsv",
          "when": "activeCustomEditorId == chrJsonEditor.editor && !chrJsonEditor.customEditorLocked"
        },
        {
          "command": "chrJsonEditor.convertCsvToJson",
          "when": "resourceExtname =~ /^\\.csv$/i && activeEditor == workbench.editors.files.textFileEditor"
        }
      ],
      "editor/title": [
        {
          "command": "chrJsonEditor.openInEditor",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5|jsonl|ndjson)$/ && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "chrJsonEditor.reopenAsText",
          "when": "activeCustomEditorId == chrJsonEditor.editor",
          "group": "navigation"
        },
        {
          "command": "chrJsonEditor.convertToJson",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != json) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(jsonc|json5|jsonl)$/)",
          "group": "1_convert@1"
        },
        {
          "command": "chrJsonEditor.convertToJsonc",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != jsonc) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|json5|jsonl)$/)",
          "group": "1_convert@2"
        },
        {
          "command": "chrJsonEditor.convertToJson5",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != json5) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|jsonc|jsonl)$/)",
          "group": "1_convert@3"
        },
        {
          "command": "chrJsonEditor.convertToJsonl",
          "when": "(activeCustomEditorId == chrJsonEditor.editor && chrJsonEditor.customEditorFormat != jsonl) || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|jsonc|json5)$/)",
          "group": "1_convert@4"
        },
        {
          "command": "chrJsonEditor.exportCsv",
          "when": "activeCustomEditorId == chrJsonEditor.editor || (activeEditor == workbench.editors.files.textFileEditor && chrJsonEditor.textEditorFormat =~ /^(json|jsonc|json5)$/)",
          "group": "2_csv@1"
        },
        {
          "command": "chrJsonEditor.importCsv",
          "when": "activeCustomEditorId == chrJsonEditor.editor && !chrJsonEditor.customEditorLocked",
          "group": "2_csv@2"
        },
        {
          "command": "chrJsonEditor.convertCsvToJson",
          "when": "resourceExtname =~ /^\\.csv$/i && activeEditor == workbench.editors.files.textFileEditor",
          "group": "2_csv@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "chrJsonEditor.compareWith",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5)$/",
          "group": "3_compare@20"
        },
        {
          "command": "chrJsonEditor.compareWithHead",
          "when": "!isWeb && !chrJsonEditor.webHost && resourceScheme == file && resourceExtname =~ /^\\.(json|jsonc|json5)$/",
          "group": "3_compare@21"
        }
      ],
      "explorer/context": [
        {
          "command": "chrJsonEditor.openInEditor",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5|jsonl|ndjson)$/ && !explorerResourceIsFolder",
          "group": "navigation@20"
        },
        {
          "command": "chrJsonEditor.compareWith",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5)$/ && !explorerResourceIsFolder && !listMultiSelection",
          "group": "3_compare@20"
        },
        {
          "command": "chrJsonEditor.compareSelected",
          "when": "resourceExtname =~ /^\\.(json|jsonc|json5)$/ && listDoubleSelection",
          "group": "3_compare@21"
        },
        {
          "command": "chrJsonEditor.compareWithHead",
          "when": "!isWeb && !chrJsonEditor.webHost && resourceScheme == file && resourceExtname =~ /^\\.(json|jsonc|json5)$/ && !explorerResourceIsFolder && !listMultiSelection",
          "group": "3_compare@22"
        },
        {
          "command": "chrJsonEditor.convertCsvToJson",
          "when": "resourceExtname =~ /^\\.csv$/i && !explorerResourceIsFolder && !listMultiSelection",
          "group": "navigation@21"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p src/webview/tsconfig.json --noEmit && node esbuild.mjs",
    "package": "pnpm --filter chr-json-editor... run build && node scripts/copy-license.mjs && node ../../scripts/check-licenses.mjs --package . --notice THIRD_PARTY_LICENSES.md && vsce package --no-dependencies",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:web": "node test/web/run.mjs"
  },
  "dependencies": {
    "@chr-json-editor/app-shell": "workspace:*",
    "@chr-json-editor/core": "workspace:*",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "mocha": "11.8.0",
    "ovsx": "1.2.0"
  }
}
