{
  "name": "chr-json-editor",
  "displayName": "CHR JSON Editor",
  "description": "Free, fully offline JSON, JSONC and JSON5 editor with tree, text and table views.",
  "version": "0.0.0",
  "private": true,
  "publisher": "christian-vrl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christian-vrl/chr-json-vscode-editor.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "chrJsonEditor.noop",
        "title": "No-op (activation check)",
        "category": "CHR JSON Editor"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.mjs",
    "package": "pnpm run build && node scripts/copy-license.mjs && vsce package --no-dependencies",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
